<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="random"
         failOnRisky="true"
         failOnWarning="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <!-- Populated from Sprint 1 onward; one suite per business module. -->
        <testsuite name="Modules">
            <directory>tests/Modules</directory>
        </testsuite>
        <!--
        | Integration — the few tests that must run on the REAL database engine.
        |
        | Everything else runs on SQLite `:memory:`, which is fast and hermetic and,
        | for column types, permissive to the point of dishonesty: a `uuid` column
        | there accepts anything. That blind spot let a composite reservation key
        | into a native `uuid` column and 500'd every checkout in production while
        | the whole suite stayed green (ADR-049 amendment).
        |
        | These tests wrap themselves in a transaction and skip when PostgreSQL is
        | unreachable, so a laptop without a database stays green.
        -->
        <testsuite name="Integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
        <exclude>
            <directory>app/Shared/Support</directory>
        </exclude>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <!--
          | THE SUITE KEEPS ITS OWN LOGS. Without this, `php artisan test` wrote
          | into the server's real audit and error files — one day's audit log
          | held 12,735 test lines against 16 genuine ones, which makes a trail
          | that exists to be evidence unreadable exactly when it is needed.
        -->
        <env name="LOG_DIRECTORY" value="testing/"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="SCOUT_DRIVER" value="null"/>
        <!--
          Scout dispatches indexing onto config('scout.queue'), whose connection
          defaults to redis. The null driver stops the suite reaching a search
          cluster but not a queue, so the first Searchable model made every save
          in its tests try to resolve `redis` and fail on DNS. Pointing the
          connection at sync makes config/scout.php's stated intent — "queued in
          every environment except tests" — actually true.
        -->
        <env name="SCOUT_QUEUE_CONNECTION" value="sync"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="DEBUGBAR_ENABLED" value="false"/>
    </php>
</phpunit>
