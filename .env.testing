###############################################################################
# MarketplaceOS — Testing environment
#
# Committed on purpose: contains no secrets and guarantees every developer and
# CI runner executes the suite against an identical, isolated configuration.
# Loaded automatically by Laravel when APP_ENV=testing.
###############################################################################

APP_NAME=MarketplaceOS
APP_ENV=testing
APP_KEY=base64:S2VlcFRoaXNLZXlGb3JUZXN0aW5nT25seTEyMzQ1Njc4OTA=
APP_DEBUG=true
APP_URL=http://localhost

APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
MARKETPLACE_CURRENCY=TRY
MARKETPLACE_COUNTRY=TR

# Hash rounds are lowered so factories that create users stay fast.
BCRYPT_ROUNDS=4

# In-memory SQLite keeps the unit/feature suite hermetic and parallel-safe.
# Integration tests that need Postgres-specific behaviour opt in via the
# `pgsql` connection and the #[Group('integration')] attribute — see
# docs/testing.md.
DB_CONNECTION=sqlite
DB_DATABASE=:memory:

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
MAIL_MAILER=array

# Never hit a real cluster from the suite.
SCOUT_DRIVER=null
SCOUT_QUEUE=false

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DEBUGBAR_ENABLED=false
TELESCOPE_ENABLED=false
SENTRY_LARAVEL_DSN=
