###############################################################################
# MarketplaceOS — Environment Template
# Copy to .env and fill in. NEVER commit a populated .env.
###############################################################################

APP_NAME=MarketplaceOS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# The public path segments a storefront answers on (ADR-035). THE FIRST IS THE
# CANONICAL — it is what `canonical_url` is built from — so the Turkish segment
# the storefront actually renders leads, and `store` is an alias it redirects
# away. A canonical URL that redirects names the wrong page as the original.
STORE_PUBLIC_PATH_SEGMENTS=magaza,store

# --- Localisation (see config/app.php + config/marketplace.php) --------------
APP_TIMEZONE=Europe/Istanbul
APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR
MARKETPLACE_CURRENCY=TRY
MARKETPLACE_COUNTRY=TR

# --- Maintenance / bootstrapping --------------------------------------------
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=redis
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily,errors
LOG_DEPRECATIONS_CHANNEL=deprecations
LOG_LEVEL=debug
LOG_DAILY_DAYS=30
LOG_AUDIT_DAYS=365

# --- Database (PostgreSQL) ---------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=marketplaceos
DB_USERNAME=marketplaceos
DB_PASSWORD=secret
DB_CHARSET=utf8
DB_SCHEMA=public
DB_SSLMODE=prefer

# --- Redis (cache + queue + session) -----------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_QUEUE_DB=2
REDIS_SESSION_DB=3
REDIS_PREFIX=marketplaceos_

CACHE_STORE=redis
CACHE_PREFIX=mos_cache
QUEUE_CONNECTION=redis
REDIS_QUEUE=default
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
BROADCAST_CONNECTION=log

# --- Horizon -----------------------------------------------------------------
HORIZON_PREFIX=horizon:mos:
HORIZON_DOMAIN=

# --- Filesystem (S3 compatible: AWS S3 / MinIO / DigitalOcean Spaces) --------
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
AWS_BUCKET=marketplaceos
AWS_ENDPOINT=http://minio:9000
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# --- Search (OpenSearch) -----------------------------------------------------
SCOUT_DRIVER=opensearch
SCOUT_QUEUE=true
SCOUT_PREFIX=mos_
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_SCHEME=http
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=
OPENSEARCH_SSL_VERIFY=false

# --- Auth / Sanctum ----------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1
SESSION_DOMAIN=localhost
AUTH_PASSWORD_TIMEOUT=10800

# --- Frontend (Next.js) ------------------------------------------------------
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Link templates the backend composes for out-of-band credentials (ADR-025).
# Tokens NEVER appear in an API response — they are emailed. These paths keep
# the backend frontend-agnostic without exposing the credential.
FRONTEND_PASSWORD_RESET_PATH=/reset-password/{token}
FRONTEND_EMAIL_VERIFY_PATH=/verify-email/{id}/{hash}

# --- Mail --------------------------------------------------------------------
MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=no-reply@marketplaceos.test
MAIL_FROM_NAME="${APP_NAME}"

# --- Error tracking ----------------------------------------------------------
# Leave SENTRY_LARAVEL_DSN empty to disable. See docs/logging.md.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Dev tooling (local only) ------------------------------------------------
DEBUGBAR_ENABLED=true
TELESCOPE_ENABLED=false

# --- Vite --------------------------------------------------------------------
VITE_APP_NAME="${APP_NAME}"
