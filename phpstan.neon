includes:
	- vendor/larastan/larastan/extension.neon
	# Every error that predates the PHPStan 2.x upgrade, captured so `analyse`
	# runs green and a NEW error fails the build. Shrink it, never regenerate it
	# to paper over new findings. @see phpstan-baseline.neon
	- phpstan-baseline.neon

parameters:
	level: 6

	paths:
		- app
		- config
		- database
		- routes
		- tests

	tmpDir: .phpstan.cache

	# `checkMissingIterableValueType` and `checkGenericClassInNonGenericObjectType`
	# were removed in PHPStan 2.0 — both behaviours are now unconditional at
	# level 6, and leaving the keys here made the tool refuse to start at all.
	checkModelProperties: true
	checkOctaneCompatibility: false

	treatPhpDocTypesAsCertain: false
	# Off while the baseline carries pre-existing errors: entries that stop
	# matching as those are fixed must not themselves fail the build.
	reportUnmatchedIgnoredErrors: false

	excludePaths:
		- app/Shared/Support/helpers.php

	ignoreErrors:
		# Filament panel providers return $this-chained builders that Larastan
		# cannot always resolve through the fluent API.
		- identifier: missingType.generics
		  path: app/Providers/Filament/*

		# Larastan types Factory::definition() as
		# `array<model property of TModel, mixed>`, but its own PHPDoc lexer
		# rejects that syntax in user code ("Unexpected token \"property\"") —
		# so the type it demands is one no factory can actually write. Every
		# factory in the project therefore declares `array<string, mixed>`.
		# A rule rather than N baseline rows, so a new module's factories are
		# covered without anyone regenerating the baseline to get there.
		- identifier: method.childReturnType
		  path: database/Modules/*/Factories/*

		# Pest binds Tests\TestCase to the Feature/Modules suites at RUNTIME
		# (see tests/Pest.php), so `$this` inside a test closure really is a
		# Tests\TestCase — but statically it is only PHPUnit's, and every
		# `$this->actingAsSeller()` / `$this->seedAll()` reads as undefined.
		# Scoped to tests/ and to that one identifier, so a genuinely missing
		# method on a real class still fails. This replaced 103 baseline rows
		# that said the same thing one call site at a time.
		- identifier: method.notFound
		  path: tests/*
		  message: '#Call to an undefined method PHPUnit\\Framework\\TestCase::#'

		# Pest's architecture DSL chains `->expect()` and `->preset()` off a
		# TestCall through a runtime mixin PHPStan cannot see, so every arch rule
		# reads as a call to an undefined method. Scoped to tests/Architecture
		# and to those two names, so a genuinely missing method on a real class
		# still fails. A rule rather than N counted baseline rows — the same
		# treatment the Pest test-case blind spot above got, and it means adding
		# an arch rule no longer means editing a number in the baseline.
		- identifier: method.notFound
		  path: tests/Architecture/*
		  message: '#Call to an undefined method Pest\\PendingCalls\\TestCall\:\:(expect|preset)\(\)#'

		# The same blind spot for state: Pest's `beforeEach` sets properties on
		# the bound test case (`$this->settings = ...`), which no static model
		# can see. Scoped identically.
		- identifier: property.notFound
		  path: tests/*
		  message: '#Access to an undefined property PHPUnit\\Framework\\TestCase::#'
